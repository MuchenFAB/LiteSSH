<UserControl x:Class="LiteSSH.Views.TerminalPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:miuix="clr-namespace:LiteSSH.Miuix">
    <Grid Background="{DynamicResource Surface}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SplitterColumn" Width="0" />
                <ColumnDefinition x:Name="SftpColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Border x:Name="TerminalHost" Grid.Column="0" Margin="10,0,10,10" Background="#101014" />

            <GridSplitter x:Name="Splitter" Grid.Column="1" Width="0" HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" ShowsPreview="False" />

            <Border x:Name="SftpHost" Grid.Column="2" Margin="0,0,10,10" Style="{StaticResource MiuixCard}" ClipToBounds="True" />
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse x:Name="StatusDot" Grid.Column="0" Width="7" Height="7" Margin="0,0,7,0"
                         Fill="{DynamicResource TextTertiary}" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Style="{StaticResource CaptionText}" />
                <TextBlock x:Name="EndpointText" Grid.Column="2" Style="{StaticResource CaptionText}" Margin="10,0,0,0"
                           Foreground="{DynamicResource TextTertiary}" />

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="GridText" Style="{StaticResource CaptionText}" Foreground="{DynamicResource TextTertiary}"
                               Margin="0,0,10,0" />
                    <Button x:Name="SftpButton" Style="{StaticResource IconButton}" Width="26" Height="24" Content="&#xE8B7;"
                            ToolTip="{miuix:Tr Action.OpenSftp}" Click="Sftp_Click" />
                    <Button x:Name="ForwardButton" Style="{StaticResource IconButton}" Width="26" Height="24" Content="&#xE968;"
                            ToolTip="{miuix:Tr Action.Forward}" Click="Forward_Click" />
                    <Button x:Name="ReconnectButton" Style="{StaticResource IconButton}" Width="26" Height="24" Content="&#xE72C;"
                            ToolTip="{miuix:Tr Action.Reconnect}" Click="Reconnect_Click" />
                    <Button x:Name="DisconnectButton" Style="{StaticResource IconButton}" Width="26" Height="24" Content="&#xE711;"
                            ToolTip="{miuix:Tr Action.Disconnect}" Click="Disconnect_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
