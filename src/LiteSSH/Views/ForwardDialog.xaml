<miuix:MiuixWindow x:Class="LiteSSH.Views.ForwardDialog"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:miuix="clr-namespace:LiteSSH.Miuix"
                   Title="{miuix:Tr Forward.Title}"
                   Width="760" Height="540"
                   ResizeMode="NoResize"
                   ShowInTaskbar="False"
                   WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="62" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
            <TextBlock Text="{miuix:Tr Forward.Title}" Style="{StaticResource H2Text}" Margin="22,0,0,0" />
            <Button Style="{StaticResource ChromeCloseButton}" Content="&#xE711;" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Click="Close_Click" />
        </Grid>

        <Grid Grid.Row="1" Margin="22,4,22,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{miuix:Tr Forward.Title}" Style="{StaticResource CaptionText}" Margin="2,0,0,6" />

                <ListBox x:Name="RuleList" Grid.Row="1" Style="{StaticResource MiuixListBox}" SelectionChanged="RuleList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="48">
                                <StackPanel VerticalAlignment="Center" Margin="8,0">
                                    <TextBlock Text="{Binding Display}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" FontSize="11" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Style="{StaticResource SecondaryButton}" Content="{miuix:Tr Action.Add}" MinWidth="72" Height="30" Click="Add_Click" />
                    <Button Style="{StaticResource DangerButton}" Content="{miuix:Tr Action.Remove}" MinWidth="72" Height="30" Margin="8,0,0,0" Click="Remove_Click" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Column="2">
                <TextBlock Text="{miuix:Tr Forward.Name}" Style="{StaticResource CaptionText}" Margin="2,0,0,5" />
                <TextBox x:Name="NameBox" Style="{StaticResource MiuixTextBox}" />

                <TextBlock Text="{miuix:Tr Forward.Type}" Style="{StaticResource CaptionText}" Margin="2,12,0,5" />
                <ComboBox x:Name="TypeBox" Style="{StaticResource MiuixComboBox}">
                    <ComboBoxItem Content="{miuix:Tr Forward.Local}" />
                    <ComboBoxItem Content="{miuix:Tr Forward.Remote}" />
                </ComboBox>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{miuix:Tr Forward.Bind}" Style="{StaticResource CaptionText}" Margin="2,0,0,5" />
                        <TextBox x:Name="BindBox" Style="{StaticResource MiuixTextBox}" Text="127.0.0.1" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{miuix:Tr Forward.BindPort}" Style="{StaticResource CaptionText}" Margin="2,0,0,5" />
                        <TextBox x:Name="BindPortBox" Style="{StaticResource MiuixTextBox}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{miuix:Tr Forward.Target}" Style="{StaticResource CaptionText}" Margin="2,0,0,5" />
                        <TextBox x:Name="TargetBox" Style="{StaticResource MiuixTextBox}" Text="127.0.0.1" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{miuix:Tr Forward.TargetPort}" Style="{StaticResource CaptionText}" Margin="2,0,0,5" />
                        <TextBox x:Name="TargetPortBox" Style="{StaticResource MiuixTextBox}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="2,14,0,0">
                    <TextBlock Text="{miuix:Tr Forward.AutoStart}" Style="{StaticResource BodyText}" />
                    <ToggleButton x:Name="AutoStartSwitch" Style="{StaticResource MiuixSwitch}" HorizontalAlignment="Right" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Content="{miuix:Tr Action.Save}" MinWidth="84" Height="32" Click="SaveRule_Click" />
                    <Button x:Name="StartButton" Style="{StaticResource SecondaryButton}" Content="{miuix:Tr Forward.Start}" MinWidth="84" Height="32" Margin="8,0,0,0" Click="Start_Click" />
                    <Button x:Name="StopButton" Style="{StaticResource SecondaryButton}" Content="{miuix:Tr Forward.Stop}" MinWidth="84" Height="32" Margin="8,0,0,0" Click="Stop_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <Grid Margin="22,0">
                <TextBlock x:Name="StatusLabel" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                <Button Style="{StaticResource SecondaryButton}" Content="{miuix:Tr Action.Close}" MinWidth="88" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Close_Click" />
            </Grid>
        </Border>
    </Grid>
</miuix:MiuixWindow>
