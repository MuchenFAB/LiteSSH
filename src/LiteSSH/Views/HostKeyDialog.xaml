<miuix:MiuixWindow x:Class="LiteSSH.Views.HostKeyDialog"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:miuix="clr-namespace:LiteSSH.Miuix"
                   Title="Host key"
                   Width="540"
                   SizeToContent="Height"
                   ResizeMode="NoResize"
                   ShowInTaskbar="False"
                   WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
            <TextBlock Text="{miuix:Tr HostKey.Title}" Style="{StaticResource H2Text}" Margin="22,0,0,0" />
            <Button Style="{StaticResource ChromeCloseButton}" Content="&#xE711;" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Click="Cancel_Click" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="22,2,22,22">
            <TextBlock x:Name="HostLabel" Style="{StaticResource BodyText}" Margin="0,0,0,10" />
            <TextBlock x:Name="DescriptionLabel" Text="{miuix:Tr HostKey.Body}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
            <TextBlock Text="{miuix:Tr Conn.Fingerprint}" Style="{StaticResource CaptionText}" Margin="0,12,0,4" />
            <Border Style="{StaticResource MiuixCardFlat}" Padding="12,10">
                <TextBlock x:Name="FingerprintLabel" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimary}" />
            </Border>

            <StackPanel x:Name="ExpectedPanel" Visibility="Collapsed" Margin="0,10,0,0">
                <TextBlock Text="{miuix:Tr HostKey.Expected}" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                <Border Style="{StaticResource MiuixCardFlat}" Padding="12,10">
                    <TextBlock x:Name="ExpectedLabel" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource Danger}" />
                </Border>
            </StackPanel>

            <Border x:Name="WarningPanel" Visibility="Collapsed" Background="{DynamicResource DangerSoft}" CornerRadius="10"
                    Padding="12,9" Margin="0,12,0,0">
                <TextBlock Text="{miuix:Tr HostKey.Changed}" Foreground="{DynamicResource Danger}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Style="{StaticResource SecondaryButton}" Content="{miuix:Tr Action.Cancel}" MinWidth="88" Click="Cancel_Click" />
                <Button Style="{StaticResource PrimaryButton}" Content="{miuix:Tr HostKey.Trust}" MinWidth="120" Margin="8,0,0,0" Click="Trust_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</miuix:MiuixWindow>
