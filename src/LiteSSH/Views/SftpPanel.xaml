<UserControl x:Class="LiteSSH.Views.SftpPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:miuix="clr-namespace:LiteSSH.Miuix">
    <UserControl.Resources>
        <miuix:BoolToVisibilityConverter x:Key="DirVis" />
        <miuix:BoolToVisibilityConverter x:Key="FileVis" Invert="True" />
    </UserControl.Resources>
    <Grid Background="{DynamicResource Surface}">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="34" />
            <RowDefinition Height="24" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="8,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="UpButton" Grid.Column="0" Style="{StaticResource IconButton}" Content="&#xE74A;" Click="Up_Click"
                    ToolTip="{miuix:Tr Sftp.Up}" Width="28" Height="28" />
            <TextBox x:Name="PathBox" Grid.Column="1" Style="{StaticResource MiuixTextBox}" Height="30" Margin="4,0"
                     Tag="{miuix:Tr Sftp.Path}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                     KeyDown="PathBox_KeyDown" />
            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE72C;" Click="Refresh_Click"
                    ToolTip="{miuix:Tr Action.Refresh}" Width="28" Height="28" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="8,0,8,4">
            <Button Style="{StaticResource GhostButton}" Height="28" Padding="8,0" Click="Upload_Click" ToolTip="{miuix:Tr Action.Upload}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE898;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,5,0" />
                    <TextBlock Text="{miuix:Tr Action.Upload}" FontSize="12" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource GhostButton}" Height="28" Padding="8,0" Click="Download_Click" ToolTip="{miuix:Tr Action.Download}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,5,0" />
                    <TextBlock Text="{miuix:Tr Action.Download}" FontSize="12" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource GhostButton}" Height="28" Padding="8,0" Click="NewFolder_Click" ToolTip="{miuix:Tr Action.NewFolder}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8F4;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,5,0" />
                    <TextBlock Text="{miuix:Tr Action.NewFolder}" FontSize="12" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource GhostButton}" Height="28" Width="28" Padding="0" Click="Delete_Click" ToolTip="{miuix:Tr Action.Delete}">
                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="12" />
            </Button>
        </StackPanel>

        <Grid Grid.Row="2" Margin="14,0,14,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="86" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{miuix:Tr Sftp.Name}" Style="{StaticResource CaptionText}" FontSize="11" />
            <TextBlock Grid.Column="1" Text="{miuix:Tr Sftp.Size}" Style="{StaticResource CaptionText}" FontSize="11" TextAlignment="Right" />
            <TextBlock Grid.Column="2" Text="{miuix:Tr Sftp.Modified}" Style="{StaticResource CaptionText}" FontSize="11" TextAlignment="Right" />
        </Grid>

        <ListBox x:Name="FileList" Grid.Row="3" Style="{StaticResource MiuixListBox}" Margin="4,0"
                 SelectionMode="Extended" MouseDoubleClick="FileList_MouseDoubleClick" KeyDown="FileList_KeyDown">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Height="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="86" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       Foreground="{DynamicResource Accent}" Margin="0,0,7,0"
                                       Visibility="{Binding IsDirectory, Converter={StaticResource DirVis}}" />
                            <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       Foreground="{DynamicResource TextTertiary}" Margin="0,0,7,0"
                                       Visibility="{Binding IsDirectory, Converter={StaticResource FileVis}}" />
                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" Style="{StaticResource CaptionText}" FontSize="11.5"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Modified, StringFormat={}{0:MM-dd HH:mm}}" Style="{StaticResource CaptionText}"
                                   FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{miuix:Tr Action.Download}" Click="Download_Click" />
                    <MenuItem Header="{miuix:Tr Action.Upload}" Click="Upload_Click" />
                    <MenuItem Header="{miuix:Tr Action.Rename}" Click="Rename_Click" />
                    <MenuItem Header="{miuix:Tr Action.Delete}" Click="Delete_Click" />
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>

        <Grid Grid.Row="4" Margin="10,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="Progress" Grid.Column="0" Width="70" Height="4" IsIndeterminate="False"
                         Visibility="Collapsed" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"
                         Background="{DynamicResource SurfacePressed}" />
            <TextBlock x:Name="StatusLabel" Grid.Column="1" Style="{StaticResource CaptionText}" FontSize="11"
                       Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>
</UserControl>
