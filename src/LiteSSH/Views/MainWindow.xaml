<miuix:MiuixWindow x:Class="LiteSSH.Views.MainWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:miuix="clr-namespace:LiteSSH.Miuix"
                   Title="LiteSSH"
                   Width="1200" Height="780"
                   MinWidth="900" MinHeight="560"
                   WindowStartupLocation="CenterScreen"
                   Icon="pack://application:,,,/Assets/icon.ico">

    <miuix:MiuixWindow.Resources>
        <miuix:BoolToVisibilityConverter x:Key="BoolToVis" />
        <miuix:EmptyToVisibilityConverter x:Key="EmptyToVis" />
        <miuix:HexToBrushConverter x:Key="HexToBrush" />
    </miuix:MiuixWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- caption bar -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent"
              MouseLeftButtonDown="TitleBar_MouseDown">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <Image Source="pack://application:,,,/Assets/logo.png" Width="19" Height="19" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="LiteSSH" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="9,0,0,0" />
                <TextBlock Text="{miuix:Tr App.Tagline}" Style="{StaticResource CaptionText}" Margin="10,1,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="{miuix:Tr Action.Settings}" Click="Settings_Click" />
                <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize" />
                <Button x:Name="MaximizeButton" Style="{StaticResource ChromeButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximize" />
                <Button Style="{StaticResource ChromeCloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="252" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- session sidebar -->
            <Grid Grid.Column="0" Margin="10,2,6,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="6,4,2,8">
                    <TextBlock Text="{miuix:Tr Nav.Sessions}" Style="{StaticResource H2Text}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="NewSessionButton" Style="{StaticResource IconButton}" Content="&#xE710;"
                                ToolTip="{miuix:Tr Nav.New}" Click="NewSession_Click" />
                    </StackPanel>
                </Grid>

                <TextBox x:Name="SearchBox" Grid.Row="1" Style="{StaticResource MiuixTextBox}"
                         Tag="{miuix:Tr Nav.Search}" Margin="2,0,2,8" TextChanged="SearchBox_TextChanged" />

                <Grid Grid.Row="2">
                    <ListBox x:Name="SessionList" Style="{StaticResource MiuixListBox}"
                             MouseDoubleClick="SessionList_MouseDoubleClick"
                             KeyDown="SessionList_KeyDown"
                             SelectionChanged="SessionList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="50" Background="Transparent" ToolTip="{Binding Endpoint}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="5" Height="24" CornerRadius="3" Margin="8,0,10,0"
                                            Background="{Binding Color, Converter={StaticResource HexToBrush}}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Endpoint}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{miuix:Tr Action.Connect}" Click="SessionConnect_Click" />
                                <MenuItem Header="{miuix:Tr Action.OpenSftp}" Click="SessionSftp_Click" />
                                <MenuItem Header="{miuix:Tr Action.Edit}" Click="SessionEdit_Click" />
                                <MenuItem Header="{miuix:Tr Action.Duplicate}" Click="SessionDuplicate_Click" />
                                <Separator />
                                <MenuItem Header="{miuix:Tr Action.Delete}" Click="SessionDelete_Click" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>

                    <TextBlock x:Name="SessionEmptyHint" Text="{miuix:Tr Nav.Empty}" Style="{StaticResource CaptionText}"
                               TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="18,0" Visibility="Collapsed" />
                </Grid>

                <Button Grid.Row="3" x:Name="SidebarNewButton" Style="{StaticResource PrimaryButton}" Height="38"
                        Margin="2,10,2,0" Click="NewSession_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="{miuix:Tr Nav.New}" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- main card -->
            <Border Grid.Column="1" Margin="0,2,10,10" Style="{StaticResource MiuixCard}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="10,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ListBox x:Name="TabStrip" Grid.Column="0" Background="Transparent" BorderThickness="0"
                                 VerticalAlignment="Center" SelectionChanged="TabStrip_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource MiuixTabItem}">
                                    <Setter Property="ToolTip" Value="{Binding Profile.Endpoint}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Margin="0,0,7,0" Fill="{Binding StatusBrush}" />
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}" MaxWidth="150" TextTrimming="CharacterEllipsis" />
                                        <Button Content="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="8" Width="18" Height="18"
                                                Margin="7,0,0,0" Style="{StaticResource GhostButton}" Padding="0" Click="TabClose_Click" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE710;"
                                ToolTip="{miuix:Tr Nav.New}" Click="NewSession_Click" VerticalAlignment="Center" />
                    </Grid>

                    <ContentControl x:Name="ContentHost" Grid.Row="1" />

                    <Grid x:Name="WelcomePanel" Grid.Row="1" Background="{DynamicResource Surface}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                            <Image Source="pack://application:,,,/Assets/logo.png" Width="72" Height="72" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="LiteSSH" Style="{StaticResource H1Text}" HorizontalAlignment="Center" Margin="0,16,0,6" />
                            <TextBlock Text="{miuix:Tr Tabs.Welcome}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                       TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,20" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource PrimaryButton}" Click="NewSession_Click" MinWidth="130" Height="38">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,8,0" />
                                        <TextBlock Text="{miuix:Tr Nav.New}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</miuix:MiuixWindow>
