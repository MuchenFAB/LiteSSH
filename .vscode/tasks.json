{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "detail": "dotnet build (Debug) -> src\\LiteSSH\\bin\\Debug\\net6.0-windows\\LiteSSH.exe",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}\\src\\LiteSSH\\LiteSSH.csproj",
        "-c",
        "Debug",
        "-p:NoWarn=NETSDK1138",
        "--nologo"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "silent",
        "clear": true,
        "panel": "shared"
      }
    },
    {
      "label": "build-and-run",
      "detail": "Build then launch the exe (no debugger)",
      "dependsOn": "build",
      "type": "process",
      "command": "${workspaceFolder}\\src\\LiteSSH\\bin\\Debug\\net6.0-windows\\LiteSSH.exe",
      "args": [],
      "options": {
        "cwd": "${workspaceFolder}\\src\\LiteSSH\\bin\\Debug\\net6.0-windows"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "clean",
      "detail": "Remove build output (bin / obj)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "clean",
        "${workspaceFolder}\\src\\LiteSSH\\LiteSSH.csproj",
        "--nologo"
      ],
      "problemMatcher": []
    },
    {
      "label": "publish",
      "detail": "Single-file Release exe into dist\\ (needs .NET 6 Desktop Runtime)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "publish",
        "${workspaceFolder}\\src\\LiteSSH\\LiteSSH.csproj",
        "-c",
        "Release",
        "-r",
        "win-x64",
        "-p:PublishSingleFile=true",
        "-p:SelfContained=false",
        "-p:DebugType=None",
        "-p:DebugSymbols=false",
        "-p:NoWarn=NETSDK1138",
        "-o",
        "${workspaceFolder}\\dist",
        "--nologo"
      ],
      "problemMatcher": "$msCompile",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "publish-selfcontained",
      "detail": "Single-file Release exe with bundled .NET runtime into dist\\selfcontained\\",
      "type": "process",
      "command": "dotnet",
      "args": [
        "publish",
        "${workspaceFolder}\\src\\LiteSSH\\LiteSSH.csproj",
        "-c",
        "Release",
        "-r",
        "win-x64",
        "--self-contained",
        "true",
        "-p:PublishSingleFile=true",
        "-p:IncludeNativeLibrariesForSelfExtract=true",
        "-p:EnableCompressionInSingleFile=true",
        "-p:DebugType=None",
        "-p:DebugSymbols=false",
        "-p:NoWarn=NETSDK1138",
        "-o",
        "${workspaceFolder}\\dist\\selfcontained",
        "--nologo"
      ],
      "problemMatcher": "$msCompile",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "publish-and-run",
      "detail": "Publish single-file exe then start it",
      "dependsOn": "publish",
      "type": "process",
      "command": "${workspaceFolder}\\dist\\LiteSSH.exe",
      "args": [],
      "options": {
        "cwd": "${workspaceFolder}\\dist"
      },
      "problemMatcher": []
    }
  ]
}
